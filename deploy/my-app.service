[Unit]
Description=Resource monitoring container
After=docker.service lab-storage.service
Requires=docker.service lab-storage.service

[Service]
Type=simple
ExecStartPre=/usr/bin/mountpoint -q /mnt/logs
ExecStart=/usr/bin/docker start -a my-app
ExecStop=/usr/bin/docker stop -t 10 my-app
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
